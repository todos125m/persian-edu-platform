// =============================================================================
// پلتفرم آموزشی فارسی - Prisma Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// نقش‌ها - Roles
// =============================================================================
model Role {
  id          String   @id @default(uuid())
  name        String   @unique // admin, instructor, user
  nameFA      String   @map("name_fa") // ادمین، مدرس، کاربر
  description String?
  
  users       User[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// =============================================================================
// کاربران - Users
// =============================================================================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  password      String
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  avatar        String?
  grade         UserGrade? // پایه تحصیلی
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")
  
  roleId        String    @map("role_id")
  role          Role      @relation(fields: [roleId], references: [id])
  
  courses       UserCourse[]
  orders        Order[]
  videoProgress VideoProgress[]
  refreshTokens RefreshToken[]
  reviews       Review[]
  quizAttempts  QuizAttempt[]
  certificates  Certificate[]
  wishlists     Wishlist[]
  notifications Notification[]
  taughtCourses  Course[]       @relation("InstructorCourses")
  courseViews    CourseView[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]

  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

enum UserGrade {
  GRADE_10     // دهم
  GRADE_11     // یازدهم
  GRADE_12     // دوازدهم
  GRADUATED    // فارغ‌التحصیل
}

// =============================================================================
// کد تایید پیامکی - OTP
// =============================================================================
model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  type      OtpType  @default(VERIFY)   // نوع: تایید شماره یا بازیابی رمز
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attempts  Int      @default(0)        // تعداد تلاش‌های نادرست
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, type])
  @@index([phone, code])
  @@map("otps")
}

enum OtpType {
  VERIFY          // تایید شماره موبایل
  FORGOT_PASSWORD // بازیابی رمز عبور
}

// =============================================================================
// دسته‌بندی‌ها - Categories
// =============================================================================
model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  nameFA      String     @map("name_fa")
  slug        String     @unique
  description String?
  icon        String?
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  
  courses     Course[]
  
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

// =============================================================================
// دوره‌ها - Courses
// =============================================================================
model Course {
  id              String       @id @default(uuid())
  title           String
  slug            String       @unique
  description     String
  shortDesc       String?      @map("short_desc")
  thumbnail       String?
  previewVideo    String?      @map("preview_video")
  
  price           Decimal      @db.Decimal(12, 0)
  discountPrice   Decimal?     @map("discount_price") @db.Decimal(12, 0)
  discountExpiry  DateTime?    @map("discount_expiry")
  
  duration        Int          @default(0)
  lessonsCount    Int          @default(0) @map("lessons_count")
  studentsCount   Int          @default(0) @map("students_count")
  viewCount       Int          @default(0) @map("view_count")
  
  level           CourseLevel  @default(BEGINNER)
  status          CourseStatus @default(DRAFT)
  isFeatured      Boolean      @default(false) @map("is_featured")
  
  categoryId      String       @map("category_id")
  category        Category     @relation(fields: [categoryId], references: [id])

  instructorId    String?      @map("instructor_id")
  instructor      User?        @relation("InstructorCourses", fields: [instructorId], references: [id])

  sections        Section[]
  lessons         Lesson[]
  userCourses     UserCourse[]
  orderItems      OrderItem[]
  reviews         Review[]
  quizzes         Quiz[]
  certificates    Certificate[]
  tags            CourseTag[]
  wishlists       Wishlist[]
  courseViews     CourseView[]

  metaTitle       String?      @map("meta_title")
  metaDescription String?      @map("meta_description")
  
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([status, isFeatured])
  @@index([instructorId])
  @@map("courses")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// =============================================================================
// بازدید دوره‌ها - Course Views
// =============================================================================
model CourseView {
  id        String   @id @default(uuid())

  courseId   String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  ip        String?
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@index([courseId])
  @@index([userId])
  @@index([viewedAt])
  @@index([courseId, viewedAt])
  @@map("course_views")
}

// =============================================================================
// بخش‌ها - Sections
// =============================================================================
model Section {
  id          String   @id @default(uuid())
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")

  courseId     String   @map("course_id")
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons      Lesson[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([courseId])
  @@index([courseId, sortOrder])
  @@map("sections")
}

// =============================================================================
// درس‌ها - Lessons
// =============================================================================
model Lesson {
  id          String   @id @default(uuid())
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isFree      Boolean  @default(false) @map("is_free")
  isPublished Boolean  @default(false) @map("is_published")

  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  sectionId  String?  @map("section_id")
  section     Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  video       Video?

  pdfUrl      String?  @map("pdf_url")
  pdfName     String?  @map("pdf_name")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([courseId])
  @@index([sectionId])
  @@index([sortOrder])
  @@index([courseId, sortOrder])
  @@map("lessons")
}

// =============================================================================
// ویدیوها - Videos
// =============================================================================
model Video {
  id           String        @id @default(uuid())
  filename     String
  originalName String        @map("original_name")
  storagePath  String        @map("storage_path")
  storageKey   String        @unique @map("storage_key")
  
  duration     Int           @default(0)
  size         BigInt        @default(0)
  mimeType     String        @default("video/mp4") @map("mime_type")
  
  status       VideoStatus   @default(PROCESSING)
  
  lessonId     String        @unique @map("lesson_id")
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  hlsPath      String?       @map("hls_path")

  progress     VideoProgress[]
  qualities    VideoQuality[]

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([storageKey])
  @@index([status])
  @@map("videos")
}

enum VideoStatus {
  PROCESSING
  TRANSCODING
  READY
  ERROR
}

// =============================================================================
// کیفیت‌های ویدیو - Video Qualities (HLS variants)
// =============================================================================
model VideoQuality {
  id          String   @id @default(uuid())

  videoId     String   @map("video_id")
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  quality     String   // e.g. "1080p", "720p", "480p", "360p"
  resolution  String   // e.g. "1920x1080"
  bitrate     Int      // kbps
  storageKey  String   @map("storage_key") // path to quality-specific playlist
  size        BigInt   @default(0)

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([videoId, quality])
  @@index([videoId])
  @@map("video_qualities")
}

// =============================================================================
// پیشرفت ویدیو - Video Progress
// =============================================================================
model VideoProgress {
  id             String   @id @default(uuid())
  
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  videoId        String   @map("video_id")
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  watchedSeconds Int      @default(0) @map("watched_seconds")
  totalSeconds   Int      @default(0) @map("total_seconds")
  isCompleted    Boolean  @default(false) @map("is_completed")
  lastPosition   Int      @default(0) @map("last_position")
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@map("video_progress")
}

// =============================================================================
// ثبت‌نام دوره - User Courses
// =============================================================================
model UserCourse {
  id          String    @id @default(uuid())
  
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseId    String    @map("course_id")
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  progress    Int       @default(0)
  isLocked    Boolean   @default(false) @map("is_locked") // قفل بخاطر عدم پرداخت قسط
  completedAt DateTime? @map("completed_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_courses")
}

// =============================================================================
// سفارش‌ها - Orders
// =============================================================================
model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique @map("order_number")
  
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id])
  
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 0)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 0)
  finalAmount    Decimal     @map("final_amount") @db.Decimal(12, 0)
  
  status         OrderStatus @default(PENDING)
  couponCode     String?     @map("coupon_code")

  items          OrderItem[]
  payment        Payment?
  installmentPlan InstallmentPlan?
  discountCode   DiscountCode? @relation(fields: [couponCode], references: [code])
  
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([status, createdAt])
  @@index([userId, status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// =============================================================================
// آیتم سفارش - Order Items
// =============================================================================
model OrderItem {
  id        String   @id @default(uuid())
  
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id])
  
  price     Decimal  @db.Decimal(12, 0)
  
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([courseId])
  @@map("order_items")
}

// =============================================================================
// پرداخت‌ها - Payments
// =============================================================================
model Payment {
  id         String         @id @default(uuid())
  
  orderId    String         @unique @map("order_id")
  order      Order          @relation(fields: [orderId], references: [id])
  
  amount     Decimal        @db.Decimal(12, 0)
  gateway    PaymentGateway
  
  authority  String?
  refId      String?        @map("ref_id")
  cardNumber String?        @map("card_number")
  
  status     PaymentStatus  @default(PENDING)
  paidAt     DateTime?      @map("paid_at")
  
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([authority])
  @@index([refId])
  @@index([status])
  @@index([status, paidAt])
  @@map("payments")
}

enum PaymentGateway {
  ZARINPAL
  IDPAY
  NEXTPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// =============================================================================
// تنظیمات - Settings
// =============================================================================
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String   @default("general")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([group])
  @@map("settings")
}

// =============================================================================
// توکن‌های بازنشانی - Refresh Tokens
// =============================================================================
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =============================================================================
// نظرات و امتیازات - Reviews
// =============================================================================
model Review {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId   String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  rating    Int      // 1-5
  comment   String?
  isApproved Boolean @default(false) @map("is_approved")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([isApproved])
  @@map("reviews")
}

// =============================================================================
// آزمون‌ها - Quizzes
// =============================================================================
model Quiz {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  description String?
  duration    Int          @default(0) // seconds
  isActive    Boolean      @default(true) @map("is_active")

  courseId     String?      @map("course_id")
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([slug])
  @@index([courseId])
  @@index([isActive])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid())

  quizId        String   @map("quiz_id")
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  question      String
  optionA       String   @map("option_a")
  optionB       String   @map("option_b")
  optionC       String   @map("option_c")
  optionD       String   @map("option_d")
  correctOption String   @map("correct_option") // A, B, C, D
  explanation   String?
  sortOrder     Int      @default(0) @map("sort_order")

  answers       QuizAnswer[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([quizId])
  @@index([quizId, sortOrder])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizId      String   @map("quiz_id")
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  score       Int      @default(0)
  totalQuestions Int   @default(0) @map("total_questions")
  correctAnswers Int  @default(0) @map("correct_answers")
  timeTaken   Int      @default(0) @map("time_taken") // seconds

  answers     QuizAnswer[]

  startedAt   DateTime @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id            String       @id @default(uuid())

  attemptId     String       @map("attempt_id")
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId    String       @map("question_id")
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOption String      @map("selected_option") // A, B, C, D
  isCorrect     Boolean      @default(false) @map("is_correct")

  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_answers")
}

// =============================================================================
// کد تخفیف - Discount Codes
// =============================================================================
model DiscountCode {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?

  type          DiscountType @default(PERCENT)
  value         Decimal      @db.Decimal(12, 0) // percent or fixed amount

  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  minAmount     Decimal?  @map("min_amount") @db.Decimal(12, 0)

  isActive      Boolean   @default(true) @map("is_active")
  expiresAt     DateTime? @map("expires_at")

  orders        Order[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("discount_codes")
}

enum DiscountType {
  PERCENT
  FIXED
}

// =============================================================================
// بازیابی رمز عبور - Password Resets
// =============================================================================
model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

// =============================================================================
// گواهینامه‌ها - Certificates
// =============================================================================
model Certificate {
  id            String   @id @default(uuid())
  certificateNo String   @unique @map("certificate_no")

  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId       String   @map("course_id")
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, courseId])
  @@index([certificateNo])
  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

// =============================================================================
// تگ‌ها - Tags
// =============================================================================
model Tag {
  id        String      @id @default(uuid())
  name      String      @unique
  slug      String      @unique

  courses   CourseTag[]

  createdAt DateTime    @default(now()) @map("created_at")

  @@index([slug])
  @@map("tags")
}

model CourseTag {
  id        String   @id @default(uuid())

  courseId   String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tagId     String   @map("tag_id")
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([courseId, tagId])
  @@index([courseId])
  @@index([tagId])
  @@map("course_tags")
}

// =============================================================================
// علاقه‌مندی‌ها - Wishlists
// =============================================================================
model Wishlist {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId   String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("wishlists")
}

// =============================================================================
// اعلان‌ها - Notifications
// =============================================================================
model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info") // info, success, warning, order, course
  link      String?
  isRead    Boolean  @default(false) @map("is_read")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// پیام‌های تماس - Contact Messages
// =============================================================================
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

// =============================================================================
// تیکت پشتیبانی - Support Tickets
// =============================================================================
model Ticket {
  id         String         @id @default(uuid())
  subject    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  department String         @default("support") // support, technical, financial

  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages   TicketMessage[]

  closedAt   DateTime?      @map("closed_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  body      String
  isAdmin   Boolean  @default(false) @map("is_admin")

  ticketId  String   @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_messages")
}

enum TicketStatus {
  OPEN
  ANSWERED
  WAITING
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// =============================================================================
// پرداخت اقساطی - Installment Plans
// =============================================================================
model InstallmentPlan {
  id              String             @id @default(uuid())

  orderId         String             @unique @map("order_id")
  order           Order              @relation(fields: [orderId], references: [id])

  totalAmount     Decimal            @map("total_amount") @db.Decimal(12, 0)
  downPayment     Decimal            @map("down_payment") @db.Decimal(12, 0)   // پیش‌پرداخت
  monthlyAmount   Decimal            @map("monthly_amount") @db.Decimal(12, 0) // مبلغ هر قسط
  totalInstallments Int              @map("total_installments")                 // تعداد اقساط
  paidInstallments  Int              @default(0) @map("paid_installments")      // اقساط پرداخت شده

  status          InstallmentStatus  @default(ACTIVE)

  installments    Installment[]

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("installment_plans")
}

model Installment {
  id              String            @id @default(uuid())

  planId          String            @map("plan_id")
  plan            InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  installmentNumber Int             @map("installment_number")
  amount          Decimal           @db.Decimal(12, 0)
  dueDate         DateTime          @map("due_date")

  status          PaymentStatus     @default(PENDING)
  paidAt          DateTime?         @map("paid_at")
  authority       String?
  refId           String?           @map("ref_id")

  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([planId])
  @@index([status])
  @@index([dueDate])
  @@map("installments")
}

enum InstallmentStatus {
  ACTIVE      // اقساط فعال
  COMPLETED   // تمام اقساط پرداخت شده
  OVERDUE     // معوق
  CANCELLED   // لغو شده
}
