# =============================================================================
# پلتفرم آموزشی فارسی - تنظیمات محیطی
# =============================================================================

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/persian_edu?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Object Storage (Arvan Cloud / S3 Compatible)
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=edu-videos
S3_REGION=ir-thr-at1

# Payment Gateway - Zarinpal
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=true

# Payment Gateway - IDPay (Optional)
IDPAY_API_KEY=your-api-key
IDPAY_SANDBOX=true
